{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.published.json",
      "{workspaceRoot}/pnpm-lock.yaml"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.generated.ts",
      "!{projectRoot}/fixtures/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "sharedGlobals"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production"],
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "check-bundle": {
      "cache": true,
      "inputs": ["production", "^production"]
    }
  },
  "release": {
    "projects": [
      "@ng-native/components",
      "@ng-native/device",
      "@ng-native/expo",
      "@ng-native/fabric",
      "@ng-native/icons",
      "@ng-native/metro",
      "@ng-native/migrate",
      "@ng-native/nx",
      "@ng-native/platform",
      "@ng-native/router",
      "@ng-native/schematics",
      "@ng-native/tailwind",
      "@ng-native/testing",
      "@ng-native/web",
      "@ng-native/web-compat",
      "@ng-native/template"
    ],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "currentVersionResolver": "disk",
      "adjustSemverBumpsForZeroMajorVersion": false,
      "preserveLocalDependencyProtocols": true,
      "git": {
        "commit": false,
        "tag": false,
        "stageChanges": true
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "file": "{workspaceRoot}/CHANGELOG.md",
        "createRelease": false
      },
      "projectChangelogs": false,
      "git": {
        "commit": true,
        "tag": true,
        "commitMessage": "Release {version}"
      }
    },
    "versionPlans": true
  }
}
