{
  "name": "@ng-native/metro",
  "version": "0.2.0",
  "description": "Metro transformer and config preset for Angular Native: Angular AOT through oxc, the linker, and the build-time CSS compiler.",
  "keywords": [
    "angular",
    "react-native",
    "angular-native",
    "ios",
    "android",
    "fabric",
    "native",
    "metro",
    "bundler",
    "aot",
    "css"
  ],
  "type": "commonjs",
  "main": "angular-transform.cjs",
  "dependencies": {
    "@angular/compiler": "^22.0.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@oxc-angular/vite": "0.0.38",
    "lightningcss": "^1.30.2"
  },
  "peerDependencies": {
    "@expo/metro-config": "*"
  },
  "peerDependenciesMeta": {
    "@expo/metro-config": {
      "optional": true
    }
  },
  "nx": {
    "tags": [
      "scope:metro",
      "layer:build"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "homepage": "https://ng-native.com/packages/metro",
  "bugs": {
    "url": "https://github.com/ng-native/ng-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-native/ng-native.git",
    "directory": "packages/metro"
  },
  "files": [
    "*.cjs",
    "css/*.cjs",
    "polyfills/*.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/metro-config": "~57.0.12",
    "typescript": "~6.0.3"
  }
}
