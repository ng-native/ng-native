{
  "$schema": "https://json-schema.org/schema",
  "$id": "NgNativeNxDesktop",
  "title": "macOS in an Angular Native app",
  "description": "Adds macOS to an Angular Native app: @ng-native/desktop, macos in expo.platforms with Expo's out-of-tree platforms flag, the config plugin, and macos and package targets.",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "The Angular Native app.",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Which app should run on macOS?",
      "x-dropdown": "projects"
    },
    "skipInstall": {
      "type": "boolean",
      "description": "Write the files without installing.",
      "default": false
    },
    "skipFormat": {
      "type": "boolean",
      "description": "Leave the generated files unformatted.",
      "default": false,
      "x-priority": "internal"
    }
  },
  "required": ["project"]
}
