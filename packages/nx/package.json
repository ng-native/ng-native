{
  "name": "@ng-native/nx",
  "version": "0.3.0",
  "description": "Nx generators for Angular Native: nx add, an Expo app project whose targets run it, and native libraries and components.",
  "keywords": [
    "angular",
    "react-native",
    "angular-native",
    "ios",
    "android",
    "fabric",
    "native",
    "nx",
    "nx-plugin",
    "generators",
    "expo"
  ],
  "type": "module",
  "generators": "./generators.json",
  "nx-migrations": {
    "migrations": "./migrations.json",
    "packageGroup": [
      "@ng-native/components",
      "@ng-native/device",
      "@ng-native/expo",
      "@ng-native/fabric",
      "@ng-native/icons",
      "@ng-native/metro",
      "@ng-native/migrate",
      "@ng-native/nx",
      "@ng-native/platform",
      "@ng-native/router",
      "@ng-native/schematics",
      "@ng-native/tailwind",
      "@ng-native/testing",
      "@ng-native/web"
    ]
  },
  "dependencies": {
    "@ng-native/migrate": "workspace:*",
    "@nx/devkit": "^23.0.0",
    "minimatch": "^10.0.0",
    "semver": "^7.7.0"
  },
  "peerDependencies": {
    "nx": "^23.0.0"
  },
  "devDependencies": {
    "@types/semver": "^7.7.0",
    "typescript": "~6.0.3"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "scope:nx",
      "layer:build"
    ],
    "implicitDependencies": [
      "@ng-native/template"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"*.test.ts\" \"{init,application,sync,library,component,migrations,tailwind}/*.test.ts\""
  },
  "license": "MIT",
  "homepage": "https://ng-native.com/packages/nx",
  "bugs": {
    "url": "https://github.com/ng-native/ng-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-native/ng-native.git",
    "directory": "packages/nx"
  },
  "files": [
    "*.cjs",
    "generators.json",
    "migrations.json",
    "*/*.cjs",
    "*/*.json",
    "files"
  ],
  "publishConfig": {
    "access": "public"
  }
}
