# Libraries' Fabric components compiled into the host: each directory in NGN_LIBRARIES comes from
# scripts/codegen-library.sh and holds a library's codegen output and a library.cmake saying what
# to compile and register.
#
# ngn_libraries provides ngn::libraryComponents() (ngn/library-components.h): the descriptor of
# every component the libraries declare, which a backend adds to the core's own.
set(NGN_LIBRARIES "" CACHE STRING "Library directories made by scripts/codegen-library.sh")

set(_lib_includes "")
set(_lib_glue_decls "")
set(_lib_glue_calls "")
set(_lib_glue "")
set(_lib_providers "")
set(_lib_targets "")
foreach(dir ${NGN_LIBRARIES})
  include(${dir}/library.cmake)
  set(_name ${NGN_LIBRARY_NAME})
  set(_codegen ${dir}/codegen/react/renderer/components/${_name})
  file(GLOB _srcs CONFIGURE_DEPENDS ${_codegen}/*.cpp)
  string(APPEND _lib_includes "#include <react/renderer/components/${_name}/ComponentDescriptors.h>\n")
  set(_include_dirs ${dir}/codegen ${_codegen})
  if(NGN_LIBRARY_COMMON_DIR)
    set(_common ${NGN_LIBRARY_COMMON_DIR}/react/renderer/components/${_name})
    file(GLOB _common_srcs CONFIGURE_DEPENDS ${_common}/*.cpp ${_common}/utils/*.cpp)
    list(APPEND _srcs ${_common_srcs})
    list(APPEND _include_dirs ${NGN_LIBRARY_COMMON_DIR})
  endif()
  foreach(d ${NGN_LIBRARY_DESCRIPTORS})
    # A descriptor the codegen does not make is the library's own, in a header named after it.
    # Only the registered ones: some libraries' unregistered headers collide in one translation unit.
    if(NGN_LIBRARY_COMMON_DIR AND EXISTS ${_common}/${d}.h)
      string(APPEND _lib_includes "#include <react/renderer/components/${_name}/${d}.h>\n")
    endif()
    string(APPEND _lib_providers "      concreteComponentDescriptorProvider<${d}>(),\n")
  endforeach()
  # The core's reading of the library's own props and state, where the core has any (library-glue.h).
  if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/core/src/libraries/${_name}.cpp)
    list(APPEND _lib_glue core/src/libraries/${_name}.cpp)
    string(APPEND _lib_glue_decls "void installGlue_${_name}();\n")
    string(APPEND _lib_glue_calls "  installGlue_${_name}();\n")
  endif()
  add_library(ngn_library_${_name} OBJECT ${_srcs})
  target_include_directories(ngn_library_${_name} SYSTEM PUBLIC ${_include_dirs})
  target_link_libraries(ngn_library_${_name} PUBLIC react_native)
  target_compile_options(ngn_library_${_name} PRIVATE -fexceptions -frtti -include cstdint -w)
  list(APPEND _lib_targets ngn_library_${_name})
endforeach()

file(CONFIGURE OUTPUT ${CMAKE_BINARY_DIR}/generated/library-components.cpp CONTENT [[
// Generated by cmake/libraries.cmake from NGN_LIBRARIES.
#include "ngn/library-components.h"
#include "ngn/library-glue.h"

#include <react/renderer/core/ConcreteComponentDescriptor.h>

#include <string_view>
@_lib_includes@
using namespace facebook::react;

namespace ngn {

@_lib_glue_decls@
std::vector<ComponentDescriptorProvider> libraryComponents() {
  static bool installed = false;
  if (!installed) {
    installed = true;
@_lib_glue_calls@  }
  // The desktop's own components first: a library's of the same name is left out.
  std::vector<ComponentDescriptorProvider> providers = libraryGlue().components;
  for (auto &provider : std::vector<ComponentDescriptorProvider>{
@_lib_providers@       }) {
    bool replaced = false;
    for (const auto &own : providers) {
      replaced = replaced || std::string_view(own.name) == provider.name;
    }
    if (!replaced) {
      providers.push_back(std::move(provider));
    }
  }
  return providers;
}

} // namespace ngn
]] @ONLY)

add_library(ngn_libraries STATIC ${CMAKE_BINARY_DIR}/generated/library-components.cpp ${_lib_glue})
target_link_libraries(ngn_libraries PUBLIC ngn_core ${_lib_targets})
target_compile_options(ngn_libraries PRIVATE -fexceptions -frtti -include cstdint -w)
