# React Native's C++ core: ReactCommon from the installed react-native package (RN_DIR) and
# ReactCxxPlatform from the matching git tag in the cache.
#
# Two sets. The renderer set (Fabric, Yoga, the components, TurboModule plumbing) is toolkit-free
# and needs no JavaScript engine: the core and its tests build on it alone, on any OS. The runtime
# set adds Hermes, the JSI executor and ReactCxxPlatform's ReactHost, for a host that runs a bundle.
#
# The directory list (the transitive closure of what ReactHost needs), the iOS TextInput variant,
# and dropping the stub TextLayoutManager.cpp follow Basalt
# 0.2.9's ReactNativeCore.cmake (MIT, Copyright (c) 2026 Vince Vella), which mirrors Fantom.

set(REACT_COMMON_DIR ${RN_DIR}/ReactCommon)
set(REACT_ANDROID_DIR ${RN_DIR}/ReactAndroid)
set(REACT_CXX_PLATFORM_DIR ${NGN_SOURCES}/react-native/packages/react-native/ReactCxxPlatform)

include(${REACT_COMMON_DIR}/cmake-utils/internal/react-native-platform-selector.cmake)

include_directories(SYSTEM
    ${REACT_COMMON_DIR}/react/renderer/graphics/platform/cxx
    ${REACT_COMMON_DIR}/react/renderer/components/view/platform/cxx
    ${REACT_COMMON_DIR}/react/renderer/textlayoutmanager/platform/cxx
    ${REACT_COMMON_DIR}/react/renderer/imagemanager/platform/cxx
    ${REACT_COMMON_DIR}/react/utils/platform/cxx
    ${REACT_COMMON_DIR}/runtimeexecutor/platform/cxx
    ${REACT_CXX_PLATFORM_DIR})

set(RN_RENDERER_DIRS
    callinvoker cxxreact devtoolsruntimesettings jserrorhandler jsiexecutor
    jsinspector-modern jsinspector-modern/cdp jsinspector-modern/network
    jsinspector-modern/tracing jsitooling logger oscompat react/bridging react/cxxstableapi
    react/debug react/featureflags react/nativemodule/core react/nativemodule/defaults
    react/nativemodule/devtoolsruntimesettings react/nativemodule/dom
    react/nativemodule/featureflags react/nativemodule/idlecallbacks
    react/nativemodule/intersectionobserver react/nativemodule/microtasks
    react/nativemodule/mutationobserver react/nativemodule/resizeobserver
    react/nativemodule/viewtransition react/nativemodule/webperformance
    react/performance/cdpmetrics react/performance/timeline react/renderer/animated
    react/renderer/animationbackend react/renderer/attributedstring react/renderer/bridging
    react/renderer/componentregistry react/renderer/componentregistry/native
    react/renderer/components/image react/renderer/components/legacyviewmanagerinterop
    react/renderer/components/modal react/renderer/components/root
    react/renderer/components/scrollview react/renderer/components/text
    react/renderer/components/view react/renderer/consistency react/renderer/core
    react/renderer/css react/renderer/debug react/renderer/dom react/renderer/graphics
    react/renderer/imagemanager react/renderer/leakchecker react/renderer/mapbuffer
    react/renderer/mounting react/renderer/observers/events
    react/renderer/observers/intersection react/renderer/observers/mutation
    react/renderer/observers/resize react/renderer/runtimescheduler react/renderer/scheduler
    react/renderer/telemetry react/renderer/textlayoutmanager react/renderer/uimanager
    react/renderer/uimanager/consistency react/renderer/viewtransition react/timing react/utils
    reactperflogger runtimeexecutor yoga)
set(RN_RUNTIME_DIRS hermes/executor hermes/inspector-modern react/runtime react/runtime/hermes)

set(rn_dirs ${RN_RENDERER_DIRS})
if(NGN_WITH_RUNTIME)
  list(APPEND rn_dirs ${RN_RUNTIME_DIRS})
endif()
foreach(dir ${rn_dirs})
  if(NOT EXISTS ${REACT_COMMON_DIR}/${dir}/CMakeLists.txt)
    message(FATAL_ERROR "react-native has no ReactCommon/${dir}: the directory list needs updating")
  endif()
  add_subdirectory(${REACT_COMMON_DIR}/${dir} ReactCommon/${dir})
endforeach()
add_library(yoga ALIAS yogacore)

# The core implements TextLayoutManager (src/text-layout-manager.cpp) over a backend's
# TextMeasurer, so React Native's stub leaves the build and its header stays.
get_target_property(_tlm react_renderer_textlayoutmanager SOURCES)
list(FILTER _tlm EXCLUDE REGEX "platform/cxx/react/renderer/textlayoutmanager/TextLayoutManager.cpp$")
set_target_properties(react_renderer_textlayoutmanager PROPERTIES SOURCES "${_tlm}")

# React Native's component codegen (FBReactNativeSpec), generated by scripts/fetch.sh.
set(CODEGEN_DIR ${NGN_SOURCES}/codegen)
file(GLOB codegen_SRC CONFIGURE_DEPENDS ${CODEGEN_DIR}/react/renderer/components/FBReactNativeSpec/*.cpp)
add_library(react_codegen_rncore OBJECT ${codegen_SRC})
target_include_directories(react_codegen_rncore SYSTEM PUBLIC ${CODEGEN_DIR}
    ${CODEGEN_DIR}/react/renderer/components/FBReactNativeSpec ${CODEGEN_DIR}/react/renderer/components)
target_link_libraries(react_codegen_rncore jsi react_nativemodule_core rrc_view)
target_compile_options(react_codegen_rncore PRIVATE -fexceptions -frtti)

# TextInput from React Native's iOS variant: portable C++ (Android's needs fbjni).
set(TI ${REACT_COMMON_DIR}/react/renderer/components/textinput)
file(GLOB ti_SRC ${TI}/*.cpp ${TI}/platform/ios/react/renderer/components/iostextinput/*.cpp)
add_library(rn_textinput OBJECT ${ti_SRC})
target_include_directories(rn_textinput SYSTEM PUBLIC ${TI} ${TI}/platform/ios ${REACT_COMMON_DIR})
target_link_libraries(rn_textinput glog folly_runtime jsi react_debug react_renderer_attributedstring
    react_renderer_componentregistry react_renderer_core react_renderer_graphics
    react_renderer_imagemanager react_renderer_mounting react_renderer_textlayoutmanager
    react_renderer_uimanager react_utils rrc_image rrc_text rrc_view yoga)
target_compile_options(rn_textinput PRIVATE -fexceptions -frtti -Wno-unknown-pragmas)

# jsi, which React Native's own CMakeLists makes a shared library (Android's layout). Here it is
# an object library like the rest, so it links in statically.
file(GLOB jsi_SRC CONFIGURE_DEPENDS ${REACT_COMMON_DIR}/jsi/jsi/*.cpp)
add_library(jsi OBJECT ${jsi_SRC})
target_include_directories(jsi PUBLIC ${REACT_COMMON_DIR}/jsi)
target_link_libraries(jsi folly_runtime glog)

if(NGN_WITH_RUNTIME)
  foreach(dir coremodules devsupport http io logging nativemodule profiling renderer/scheduler
              renderer/uimanager runtime threading utils)
    add_subdirectory(${REACT_CXX_PLATFORM_DIR}/react/${dir} ReactCxxPlatform/${dir})
  endforeach()
  # The core's src/dev-server-helper.cpp replaces upstream's, which hard-codes `android` as the
  # bundle's and the HMR client's platform. Its header stays.
  get_target_property(_dsh react_cxx_platform_react_devsupport SOURCES)
  list(FILTER _dsh EXCLUDE REGEX "/devsupport/DevServerHelper.cpp$")
  set_target_properties(react_cxx_platform_react_devsupport PROPERTIES SOURCES "${_dsh}")
endif()

# Every React Native object library, as one static archive: a binary takes only the objects it
# references, so the core tests link without Hermes even though some objects mention it.
function(ngn_collect_targets dir out)
  get_property(ts DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
  get_property(subs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
  foreach(s ${subs})
    ngn_collect_targets(${s} sub)
    list(APPEND ts ${sub})
  endforeach()
  set(${out} ${ts} PARENT_SCOPE)
endfunction()
ngn_collect_targets(${CMAKE_CURRENT_SOURCE_DIR} _all_targets)
set(RN_OBJECT_LIBRARIES)
foreach(t ${_all_targets})
  get_target_property(type ${t} TYPE)
  if(type STREQUAL "OBJECT_LIBRARY")
    list(APPEND RN_OBJECT_LIBRARIES ${t})
    target_compile_options(${t} PRIVATE -include cstdint -w)
  endif()
endforeach()
target_compile_options(yogacore PRIVATE -include cstdint -w)

add_library(react_native STATIC)
# Linked directly, an object library's objects go into the archive, and its include directories,
# definitions and link dependencies carry on to whatever links the archive.
target_link_libraries(react_native PUBLIC ${RN_OBJECT_LIBRARIES})
target_link_libraries(react_native PUBLIC yogacore folly_runtime glog fmt double-conversion boost fast_float)
