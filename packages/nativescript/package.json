{
  "name": "@ng-native/nativescript",
  "version": "0.15.0",
  "description": "NativeScript's iOS and Android APIs in Angular Native: provideNativeScript, a NativeScript service and a <native-view> for a UIView built in TypeScript.",
  "keywords": [
    "angular",
    "react-native",
    "angular-native",
    "nativescript",
    "ios",
    "android",
    "jsi"
  ],
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@ng-native/fabric": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@nativescript/react-native": "^9.1.2",
    "react-native": ">=0.86.0",
    "react-native-worklets": ">=0.8.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "nx": {
    "tags": [
      "scope:nativescript",
      "layer:angular"
    ]
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "homepage": "https://ng-native.com/guide/native-modules/nativescript",
  "bugs": {
    "url": "https://github.com/ng-native/ng-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-native/ng-native.git",
    "directory": "packages/nativescript"
  },
  "files": [
    "dist",
    "app.plugin.cjs"
  ],
  "devDependencies": {
    "@angular/core": "22.2.0",
    "@babel/core": "^7.29.7"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./app.plugin.cjs": "./app.plugin.cjs"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./app.plugin.cjs": "./app.plugin.cjs",
      "./package.json": "./package.json"
    }
  }
}
