{
  "name": "@ng-native/icons",
  "version": "0.2.0",
  "description": "@ng-icons rendered as native react-native-svg shapes in Angular Native.",
  "keywords": [
    "angular",
    "react-native",
    "angular-native",
    "ios",
    "android",
    "fabric",
    "native",
    "icons",
    "ng-icons",
    "svg"
  ],
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@ng-native/fabric": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@ng-icons/core": ">=30",
    "react-native-svg": ">=15"
  },
  "nx": {
    "tags": [
      "scope:icons",
      "layer:angular"
    ]
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "homepage": "https://ng-native.com/packages/icons",
  "bugs": {
    "url": "https://github.com/ng-native/ng-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-native/ng-native.git",
    "directory": "packages/icons"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@angular/core": "22.2.0",
    "@babel/core": "^7.29.7"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
