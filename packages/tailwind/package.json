{
  "name": "@ng-native/tailwind",
  "version": "0.0.0",
  "description": "Tailwind CSS preset for Angular Native: Tailwind 4 on native and web, Tailwind 3 on native.",
  "keywords": [
    "angular",
    "react-native",
    "angular-native",
    "ios",
    "android",
    "fabric",
    "native",
    "tailwind",
    "tailwindcss",
    "css"
  ],
  "type": "commonjs",
  "main": "flatten.cjs",
  "dependencies": {
    "@ng-native/metro": "workspace:*",
    "lightningcss": "^1.30.2"
  },
  "nx": {
    "tags": [
      "scope:tailwind",
      "layer:build"
    ]
  },
  "license": "MIT",
  "homepage": "https://ng-native.com/packages/tailwind",
  "bugs": {
    "url": "https://github.com/ng-native/ng-native/issues"
  },
  "peerDependencies": {
    "@ng-native/metro": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^3.4.1 || ^4.3.3"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/cli": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-native/ng-native.git",
    "directory": "packages/tailwind"
  },
  "files": [
    "*.cjs",
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
