    "@ng-native/web": "workspace:*",
    "@ng-native/web-compat": "workspace:*",
    "@oxc-angular/vite": "0.0.41",
    "@picocss/pico": "2.1.1",
    "@storybook/html-vite": "10.6.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "~19.3.0",
    "bootstrap": "5.3.8",
