{
  "name": "@ng-native/integration-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import ./register-linker.mjs --test \"**/*.test.ts\" && pnpm test:layout-asks",
    "layout-fuzz": "node --import ./register-linker.mjs layout-fuzz/run.ts",
    "test:layout-asks": "node --import ./layout-asks-check.mjs --import ./register-linker.mjs --test \"css-*.test.ts\"",
    "css-oracle": "node scripts/generate-css-oracle.mjs",
    "tailwind-oracle": "node scripts/generate-tailwind-oracle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "node --no-opt --no-sparkplug --no-maglev --import ./bench/release.mjs --import @ng-native/testing/register bench/renderer.bench.ts",
    "bench:screens": "node --no-opt --no-sparkplug --no-maglev --import ./bench/release.mjs --import ./register-linker.mjs bench/screens.bench.ts",
    "bench:tailwind": "node --no-opt --no-sparkplug --no-maglev --import ./bench/release.mjs --import ./register-linker.mjs bench/tailwind.bench.ts"
  },
  "nx": {
    "tags": [
      "scope:integration-tests",
      "layer:tests"
    ],
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/scripts/coverage.mjs"
        ]
      }
    }
  },
  "devDependencies": {
    "@analogjs/router": "~2.8.0",
    "@angular/common": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/localize": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.8",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@expo/ui": "~58.0.21",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@jsverse/transloco": "8.4.0",
    "@jsverse/transloco-messageformat": "8.4.0",
    "@jsverse/transloco-utils": "8.4.0",
    "@ng-icons/core": "^36.0.0",
    "@ng-icons/heroicons": "^36.0.0",
    "@ng-icons/lucide": "^36.0.0",
    "@ng-native/analog": "workspace:*",
    "@ng-native/components": "workspace:*",
    "@ng-native/device": "workspace:*",
    "@ng-native/expo": "workspace:*",
    "@ng-native/fabric": "workspace:*",
    "@ng-native/icons": "workspace:*",
    "@ng-native/metro": "workspace:*",
    "@ng-native/migrate": "workspace:*",
