{
  "name": "@ng-native/web-compat",
  "version": "0.16.0",
  "description": "Opt-in DOM compatibility for Angular Native, so component libraries written for the browser can render as native views.",
  "keywords": [
    "angular",
    "react-native",
    "angular-native",
    "ios",
    "android",
    "fabric",
    "native",
    "dom",
    "compatibility"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./metro": {
      "types": "./build.d.cts",
      "default": "./build.cjs"
    },
    "./vitest": {
      "types": "./build.d.cts",
      "default": "./build.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./metro": {
        "types": "./build.d.cts",
        "default": "./build.cjs"
      },
      "./vitest": {
        "types": "./build.d.cts",
        "default": "./build.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@ng-native/fabric": "workspace:*",
    "@ng-native/platform": "workspace:*",
    "parse5": "^7.3.0"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0"
  },
  "devDependencies": {
    "@angular/common": "22.2.0",
    "@angular/core": "22.2.0",
    "@ng-native/components": "workspace:*",
    "@ng-native/testing": "workspace:*"
  },
  "nx": {
    "tags": [
      "scope:web-compat",
      "layer:compat"
    ]
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import @ng-native/testing/register --test \"src/*.test.ts\""
  },
  "license": "MIT",
  "homepage": "https://ng-native.com/packages/web-compat",
  "bugs": {
    "url": "https://github.com/ng-native/ng-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-native/ng-native.git",
    "directory": "packages/web-compat"
  },
  "files": [
    "dist",
    "build.cjs",
    "build.d.cts"
  ]
}
