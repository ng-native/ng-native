{
  "name": "@ng-native/testing",
  "version": "0.22.2",
  "description": "Test Angular Native components in Node with no simulator: a fake Fabric, Testing Library queries and events, and Vitest and node:test integration.",
  "keywords": [
    "angular",
    "react-native",
    "angular-native",
    "ios",
    "android",
    "fabric",
    "native",
    "testing",
    "testing-library",
    "vitest",
    "node-test"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vitest": {
      "types": "./runner/vitest.d.mts",
      "default": "./runner/vitest.mjs"
    },
    "./register": "./runner/register.mjs",
    "./loader": "./runner/loader.mjs",
    "./device": "./src/device/index.ts",
    "./device/host": "./src/device/host.ts",
    "./device/pool": "./src/device/pool.ts",
    "./device/vitest": "./src/device/vitest.ts",
    "./device/mocks": "./src/device/mocks.ts",
    "./device/loader": "./src/device/loader.ts",
    "./device/mock-registry": "./src/device/mock-registry.ts",
    "./device/bundle-modules": "./src/device/bundle-modules.ts",
    "./device/metro": {
      "types": "./device/metro.d.cts",
      "default": "./device/metro.cjs"
    },
    "./device/transformer": "./device/transformer.cjs",
    "./device/launcher": "./src/device/launcher.ts",
    "./device/macos-launcher": "./src/device/macos-launcher.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vitest": {
        "types": "./runner/vitest.d.mts",
        "default": "./runner/vitest.mjs"
      },
      "./register": "./runner/register.mjs",
      "./loader": "./runner/loader.mjs",
      "./device": {
        "types": "./dist/device/index.d.ts",
        "default": "./dist/device/index.js"
      },
      "./device/host": {
        "types": "./dist/device/host.d.ts",
        "default": "./dist/device/host.js"
      },
      "./device/pool": {
        "types": "./dist/device/pool.d.ts",
        "default": "./dist/device/pool.js"
      },
      "./device/vitest": {
        "types": "./dist/device/vitest.d.ts",
        "default": "./dist/device/vitest.js"
      },
      "./device/mocks": {
        "types": "./dist/device/mocks.d.ts",
        "default": "./dist/device/mocks.js"
      },
      "./device/loader": {
        "types": "./dist/device/loader.d.ts",
        "default": "./dist/device/loader.js"
      },
      "./device/mock-registry": {
        "types": "./dist/device/mock-registry.d.ts",
        "default": "./dist/device/mock-registry.js"
      },
      "./device/bundle-modules": {
        "types": "./dist/device/bundle-modules.d.ts",
        "default": "./dist/device/bundle-modules.js"
      },
      "./device/metro": {
        "types": "./device/metro.d.cts",
        "default": "./device/metro.cjs"
      },
      "./device/transformer": "./device/transformer.cjs",
      "./device/launcher": {
        "types": "./dist/device/launcher.d.ts",
        "default": "./dist/device/launcher.js"
      },
      "./device/macos-launcher": {
        "types": "./dist/device/macos-launcher.d.ts",
        "default": "./dist/device/macos-launcher.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@ng-native/fabric": "workspace:*",
    "@ng-native/metro": "workspace:*",
    "@ng-native/platform": "workspace:*",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "vitest": "^4.0.8 || ^5.0.0",
    "@ng-native/components": "workspace:*",
    "@ng-native/device": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@angular/compiler": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/router": "22.2.0",
    "@ng-native/components": "workspace:*",
    "@ng-native/device": "workspace:*",
    "@ng-native/router": "workspace:*",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "nx": {
    "tags": [
      "scope:testing",
      "layer:testing"
    ]
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ./runner/register.mjs --test \"src/**/*.node.test.ts\" && vitest run"
  },
  "license": "MIT",
  "homepage": "https://ng-native.com/packages/testing",
  "bugs": {
    "url": "https://github.com/ng-native/ng-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-native/ng-native.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist",
    "runner",
    "device"
  ]
}
