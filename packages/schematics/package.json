{
  "name": "@ng-native/schematics",
  "version": "0.9.0",
  "description": "ng add and ng generate for Angular Native: an Expo app in an Angular CLI workspace, with builders that run it.",
  "keywords": [
    "angular",
    "react-native",
    "angular-native",
    "ios",
    "android",
    "fabric",
    "native",
    "schematics",
    "angular-cli",
    "ng-add",
    "expo"
  ],
  "type": "module",
  "schematics": "./collection.json",
  "builders": "./builders.json",
  "ng-add": {
    "save": "devDependencies"
  },
  "ng-update": {
    "migrations": "./migrations.json",
    "packageGroupName": "@ng-native/schematics",
    "packageGroup": [
      "@ng-native/analog",
      "@ng-native/components",
      "@ng-native/device",
      "@ng-native/expo",
      "@ng-native/fabric",
      "@ng-native/icons",
      "@ng-native/metro",
      "@ng-native/migrate",
      "@ng-native/nx",
      "@ng-native/platform",
      "@ng-native/router",
      "@ng-native/schematics",
      "@ng-native/tailwind",
      "@ng-native/testing",
      "@ng-native/web"
    ]
  },
  "dependencies": {
    "@angular-devkit/architect": ">=0.2200.0 <0.2300.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular-devkit/schematics": "^22.0.0",
    "@ng-native/migrate": "workspace:*"
  },
  "devDependencies": {
    "@schematics/angular": "22.1.9"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "scope:schematics",
      "layer:build"
    ],
    "implicitDependencies": [
      "@ng-native/template"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"*.test.ts\" \"{application,component,builders,migrations}/*.test.ts\""
  },
  "license": "MIT",
  "homepage": "https://ng-native.com/packages/schematics",
  "bugs": {
    "url": "https://github.com/ng-native/ng-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-native/ng-native.git",
    "directory": "packages/schematics"
  },
  "files": [
    "*.cjs",
    "collection.json",
    "builders.json",
    "migrations.json",
    "*/*.cjs",
    "*/*.json",
    "files"
  ],
  "publishConfig": {
    "access": "public"
  }
}
