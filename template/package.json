{
  "name": "@ng-native/template",
  "version": "0.10.0",
  "description": "An Angular app rendering real native views. Use with create-expo-app --template.",
  "license": "MIT",
  "main": "src/main.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node -e \"console.error('This app targets iOS and Android: use npm start, npm run ios or npm run android. To render it in a browser, see https://ng-native.com/packages/web#beside-a-native-app'); process.exit(1)\"",
    "typecheck": "node metro.config.js && ngc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ng-native/components": "workspace:*",
    "@ng-native/device": "workspace:*",
    "@ng-native/fabric": "workspace:*",
    "@ng-native/metro": "workspace:*",
    "@ng-native/platform": "workspace:*",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "expo": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@angular/compiler-cli": "^22.0.0",
    "@babel/core": "^7.29.7",
    "@ng-native/testing": "workspace:*",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-native/ng-native.git",
    "directory": "template"
  }
}
