{
  "name": "nativescript-example",
  "version": "1.0.0",
  "private": true,
  "main": "src/main.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "export": "expo export --platform ios --platform android --output-dir dist"
  },
  "dependencies": {
    "@angular/core": "22.2.0",
    "@nativescript/react-native": "9.1.2",
    "@ng-native/components": "workspace:*",
    "@ng-native/device": "workspace:*",
    "@ng-native/fabric": "workspace:*",
    "@ng-native/nativescript": "workspace:*",
    "@ng-native/platform": "workspace:*",
    "expo": "~58.0.16",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@nativescript/types-android": "9.1.1",
    "@ng-native/metro": "workspace:*",
    "@ng-native/testing": "workspace:*",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "nx": {
    "tags": [
      "scope:nativescript-example",
      "layer:app"
    ]
  }
