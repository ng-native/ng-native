{
  "expo": {
    "name": "Runs",
    "slug": "runs-example",
    "scheme": "runs",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.angularnative.runs",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Runs uses your location to track your route, distance and pace while you run."
      }
    },
    "android": {
      "package": "dev.angularnative.runs"
    },
    "plugins": [
      "@ng-native/metro",
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Allow $(PRODUCT_NAME) to show where you are on the map"
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "src/app"
      }
    }
  }
}
