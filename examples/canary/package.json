{
  "name": "canary",
  "private": true,
  "main": "src/main.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "release:ios": "expo run:ios --configuration Release",
    "release:android": "expo run:android --variant release",
    "check-bundle": "node scripts/check-release-bundle.mjs",
    "typecheck": "node metro.config.js && ngc -p tsconfig.json --noEmit",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "test": "vitest run",
    "e2e:ios": "xcrun simctl status_bar booted override --time 9:41 --batteryState charged --batteryLevel 100 --wifiBars 3 && JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@21} maestro test .maestro/ios",
    "e2e:ios:record": "xcrun simctl status_bar booted override --time 9:41 --batteryState charged --batteryLevel 100 --wifiBars 3 && node .maestro/ios/record-baselines.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@expo/ui": "~58.0.21",
    "@ng-icons/core": "^36.0.0",
    "@ng-icons/heroicons": "^36.0.0",
    "@ng-icons/lucide": "^36.0.0",
    "@ng-native/components": "workspace:*",
    "@ng-native/device": "workspace:*",
    "@ng-native/expo": "workspace:*",
    "@ng-native/fabric": "workspace:*",
    "@ng-native/icons": "workspace:*",
    "@ng-native/platform": "workspace:*",
    "@ng-native/router": "workspace:*",
    "@ng-native/web": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.16",
    "expo-apple-authentication": "~58.0.2",
    "expo-audio": "^58.0.9",
    "expo-battery": "~58.0.3",
    "expo-brightness": "~58.0.2",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-file-system": "~58.0.10",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-keep-awake": "~58.0.3",
    "expo-local-llm": "^0.8.1",
    "expo-localization": "~58.0.5",
    "expo-maps": "~58.0.10",
    "expo-modules-core": "~58.0.23",
    "expo-network": "~58.0.3",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@ng-native/metro": "workspace:*",
    "@ng-native/tailwind": "workspace:*",
    "@ng-native/testing": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "~19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "nx": {
    "tags": [
      "scope:canary",
      "layer:app"
    ]
  },
  "version": "1.0.0"
}
