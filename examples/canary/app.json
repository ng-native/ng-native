{
  "expo": {
    "name": "canary",
    "slug": "canary",
    "scheme": "canary",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "macos"],
    "experiments": {
      "outOfTreePlatforms": true
    },
    "ios": {
      "bundleIdentifier": "dev.angularnative.canary",
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "dev.angularnative.canary"
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      "@ng-native/metro",
      "@ng-native/desktop",
      "expo-calendar",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "src/app"
      }
    }
  }
}
