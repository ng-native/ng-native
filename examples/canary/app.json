{
  "expo": {
    "name": "canary",
    "slug": "canary",
    "scheme": "canary",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.angularnative.canary",
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "dev.angularnative.canary"
    },
    "userInterfaceStyle": "automatic",
    "plugins": ["@ng-native/metro", "expo-localization", "expo-secure-store"],
    "extra": {
      "router": {
        "root": "src/app"
      }
    }
  }
}
