{
  "expo": {
    "name": "Notes",
    "slug": "notes-example",
    "scheme": "notes",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "macos"],
    "experiments": {
      "outOfTreePlatforms": true
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.angularnative.notes"
    },
    "android": {
      "package": "dev.angularnative.notes"
    },
    "plugins": ["@ng-native/metro", "@ng-native/desktop"],
    "extra": {
      "router": {
        "root": "src/app"
      }
    }
  }
}
